{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --config /home/jantrojak/.config/ccstatusline/personal.json --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccstatusline --config /home/jantrojak/.config/ccstatusline/personal.json --hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline --config /home/jantrojak/.config/ccstatusline/personal.json",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
