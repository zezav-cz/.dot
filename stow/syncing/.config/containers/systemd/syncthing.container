[Unit]
Description=Syncthing Service - use to sync files among systems
After=network-online.target

[Container]
Image=docker.io/syncthing/syncthing:latest
ContainerName=syncthing
# web UI
PublishPort=8384:8384
# sync
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp
# discover
PublishPort=21027:21027/udp
# config
Volume=%h/.config/syncthing:/var/syncthing/config:rw
# sync falders
Volume=%h/vnotes:/var/syncthing/VNotes:rw
# UID:GID mapping
User=%U
Group=%G
UserNS=keep-id
[Service]
Restart=always

[Install]
WantedBy=default.target
