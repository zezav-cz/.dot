[include]
  path = ~/.config/git/core.gitconfig
[includeIf "gitdir:~/dev/recombee/"]
  path = ~/.config/git/recombee.gitconfig
[includeIf "gitdir:~/recombee/"]
  path = ~/.config/git/recombee.gitconfig
; [includeIf "gitdir:~/dev/fit/"]
;    path = ~/.config/git/fit.gitconfig
[rerere]
	enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	pushf = push --force-with-lease
[push]
	useForceIfIncludes = true
