[user]
  name = Jan Trojak
  email = trojakjan24@gmail.com
[color]
  ui = auto
[push]
  default = simple
[core]
  autocrlf = input
  pager = delta
[delta]
  navigate = true
  side-by-side = false
  syntax-theme = gruvbox-dark
[interactive]
  diffFilter = delta --color-only
[alias]
  st = status
  ci = commit
  co = checkout
  br = branch
  ll = log --oneline --graph --all --decorate
  wf = config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
[submodule]
  recurse = true
[init]
  defaultBranch = main
[column]
  ui = auto
