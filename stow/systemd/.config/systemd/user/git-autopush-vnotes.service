[Unit]
Description=Sync vnotes with git (pull + commit + push)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/vnotes
ExecStart=/usr/bin/bash -c 'git add -A && git diff-index --quiet HEAD || git commit -m "Auto-commit: $(date -Iseconds)"; git pull --rebase --autostash && git push'

[Install]
WantedBy=default.target
