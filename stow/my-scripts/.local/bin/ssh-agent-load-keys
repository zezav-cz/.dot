#!/usr/bin/env bash
set -euo pipefail

# Load keys into the running ssh-agent with confirm-on-use (-c).
# Keys come from ~/.config/ssh-agent/keys.conf: one path per line,
# blank lines and '#' comments ignored, '~' expanded to $HOME.
# On first run creates a commented sample and exits.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ssh-agent/keys.conf"

if [[ ! -f "$CONF" ]]; then
  mkdir -p "$(dirname "$CONF")"
  cat >"$CONF" <<'EOF'
# ssh-agent keys to load with confirm-on-use (ssh-add -c).
# One key path per line. '~' expands to $HOME. '#' starts a comment.
#
# Example:
# ~/.ssh/id_ed25519
# ~/.ssh/id_ed25519_work
EOF
  echo "ssh-agent-load-keys: created sample $CONF — edit it and re-run." >&2
  exit 0
fi

added=0
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue
  [[ "$line" == "~"* ]] && line="$HOME${line#\~}"

  if [[ ! -f "$line" ]]; then
    echo "ssh-agent-load-keys: skipping missing key $line" >&2
    continue
  fi
  echo "ssh-agent-load-keys: adding $line (confirm-on-use)" >&2
  ssh-add -c "$line" </dev/null
  added=$((added + 1))
done <"$CONF"

if [[ $added -eq 0 ]]; then
  echo "ssh-agent-load-keys: no keys in $CONF — all lines are blank/comments." >&2
  echo "Edit that file and add key paths (one per line), then re-run." >&2
fi
