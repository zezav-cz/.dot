#!/usr/bin/env bash
set -euo pipefail

# Toggle screen recording with wf-recorder.
# First invocation: pick audio source via rofi, pick region via slurp, record.
# Second invocation (while recording): stop cleanly.

REC_DIR="$HOME/rec"

if pgrep -x wf-recorder >/dev/null; then
  pkill -INT -x wf-recorder
  exit 0
fi

choice=$(printf '%s\n' \
  "No audio" \
  "System audio" \
  "Microphone" \
  "System audio + microphone" \
  | rofi -dmenu -p "Recording" -l 4) || exit 0

audio_args=()
cleanup_modules=()

cleanup() {
  local id
  for id in "${cleanup_modules[@]}"; do
    pactl unload-module "$id" 2>/dev/null || true
  done
}
trap cleanup EXIT

case "$choice" in
  "No audio") ;;
  "System audio")
    audio_args=(--audio="$(pactl get-default-sink).monitor")
    ;;
  "Microphone")
    audio_args=(--audio="$(pactl get-default-source)")
    ;;
  "System audio + microphone")
    # wf-recorder accepts a single audio device, so mix system output and
    # mic into a temporary null sink and record its monitor.
    mix_id=$(pactl load-module module-null-sink sink_name=screenrec_mix \
      sink_properties=device.description=screenrec_mix)
    cleanup_modules+=("$mix_id")
    out_id=$(pactl load-module module-loopback \
      source="$(pactl get-default-sink).monitor" sink=screenrec_mix)
    cleanup_modules+=("$out_id")
    mic_id=$(pactl load-module module-loopback \
      source="$(pactl get-default-source)" sink=screenrec_mix)
    cleanup_modules+=("$mic_id")
    audio_args=(--audio=screenrec_mix.monitor)
    ;;
  *) exit 0 ;;
esac

geometry=$(slurp) || exit 0

mkdir -p "$REC_DIR"
file="$REC_DIR/rec-$(date +%Y%m%d-%H%M%S).mp4"

notify-send -t 3000 "Screen recording" "Recording ($choice) → $file"
wf-recorder -g "$geometry" -f "$file" "${audio_args[@]}" &
rec_pid=$!
# Nudge the waybar custom/recording module once wf-recorder shows up in
# the process list (its comm name changes only after exec).
sleep 0.2
pkill -RTMIN+8 waybar 2>/dev/null || true
wait "$rec_pid" || true
pkill -RTMIN+8 waybar 2>/dev/null || true
notify-send -t 5000 "Screen recording" "Saved: $file"
