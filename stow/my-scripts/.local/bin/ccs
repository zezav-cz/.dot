#!/usr/bin/env bash
#
# ccs -- start Claude Code with a session name.
#
# Injects `--name <derived>` when no name was passed, so unnamed sessions
# stop piling up in the `/resume` picker.
#
# Usage: ccs [any claude flag or prompt ...]
#
#   ccs                      # new session, named "<repo>:<branch>"
#   ccs -n "routing dump"    # explicit name wins; nothing is derived
#   ccs -r alerting          # resume picker, pre-filtered
#   ccs -c                   # continue the most recent session here
#   ccs -w device-inventory  # new git worktree + session for it
#
# Env:
#   CLAUDE_CONFIG_DIR  read by claude itself -- set it to run the personal
#                      instance (that is all the `pclaude` alias does).
#   CLAUDE_BIN         override the binary (default: claude from PATH).

set -euo pipefail

claude_bin=${CLAUDE_BIN:-claude}

# "<repo>:<branch>" inside a git repo, "<branch>" alone when the repo
# directory and the branch would read the same, otherwise the directory name.
derive_name() {
  local root branch
  if root=$(git rev-parse --show-toplevel 2>/dev/null); then
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
      branch=$(git rev-parse --short HEAD 2>/dev/null) ||
      branch=""
    if [[ -n $branch ]]; then
      printf '%s:%s' "${root##*/}" "$branch"
      return
    fi
    printf '%s' "${root##*/}"
    return
  fi
  printf '%s' "${PWD##*/}"
}

has_name=0
skip_naming=0
for arg in "$@"; do
  case $arg in
    -n | --name | -n=* | --name=*)
      has_name=1
      ;;
    # -p prints and exits; resuming already carries a stored name, and
    # subcommands (agents, mcp, doctor, ...) are not sessions at all.
    -p | --print | -c | --continue | -r | --resume | --from-pr | --teleport | --cloud | --attach)
      skip_naming=1
      ;;
    agents | attach | auth | doctor | logs | mcp | plugin | plugins | project | respawn | rm | stop | kill | update | upgrade | install | import | gateway | setup-token | ultrareview)
      skip_naming=1
      ;;
  esac
done

args=()
if ((!has_name && !skip_naming)); then
  args+=(--name "$(derive_name)")
fi
if (($#)); then
  args+=("$@")
fi

exec "$claude_bin" "${args[@]}"
