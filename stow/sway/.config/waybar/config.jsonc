{
  "layer": "top",
  "position": "top",
  "height": 20,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-right": [
    "custom/recording",
    "custom/colorscheme",
    "custom/gammastep",
    "custom/notification",
    "idle_inhibitor",
    "network",
    "bluetooth",
    "sway/language",
    "battery",
    "pulseaudio",
    "tray",
    "clock",
    "custom/power"
  ],
  "sway/workspaces": {
    "tooltip": false,
    "all-outputs": true
  },
  "custom/recording": {
    "format": "{}",
    "interval": 5,
    "signal": 8,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/recording.sh",
    "on-click": "~/.local/bin/screenrecord",
    "tooltip": true
  },
  "custom/colorscheme": {
    "format": "󰸌",
    "interval": 5,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/colorscheme.sh",
    "on-click": "~/.config/waybar/scripts/colorscheme.sh toggle",
    "tooltip": true
  },
  "custom/gammastep": {
    "format": " {}",
    "interval": 5,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/gammastep.sh",
    "on-click": "~/.config/waybar/scripts/gammastep.sh toggle",
    "tooltip": true
  },
  "pulseaudio": {
    "scroll-step": 1,
    "format": "{icon} {volume}%  {format_source}",
    "format-bluetooth": "{icon} {volume}%  {format_source}",
    "format-bluetooth-muted": "󰝟  {format_source}",
    "format-muted": "󰝟  {format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "{desc}"
  },
  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰾪"
    },
    "tooltip": true,
    "tooltip-format-activated": "Idle inhibitor: on — screen will stay awake",
    "tooltip-format-deactivated": "Idle inhibitor: off — screen may sleep"
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": true,
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "No network connection"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "format-no-controller": "",
    "interval": 10,
    "tooltip": true,
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_alias}\n{device_battery_percentage}% battery",
    "on-click": "foot -e bluetoothctl"
  },
  "sway/language": {
    "format": " {short}",
    "tooltip": true,
    "tooltip-format": "{long}"
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂔 {capacity}%",
    "format-plugged": "󰚚 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "{timeTo}\n{power}W"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },
  "clock": {
    "interval": 10,
    "format": "{:%d %b  %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y\nWeek %V}"
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "nwg-bar -x",
    "tooltip": false
  }
}
