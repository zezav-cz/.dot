/fonts/
.venv/
__pycache__/
*.pyc
.worktrees/

# the global git ignore (stow/git) excludes **/.claude/ -- re-include our stow package
!stow/claude/.claude/

# Generated by home-manager: in ~ this is a symlink into /nix/store, and the
# copy that landed under stow/ carries a store hash that stops resolving after
# the next garbage collection.
stow/systemd/.config/environment.d/10-home-manager.conf
