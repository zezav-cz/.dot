#!/usr/bin/env bash
# Check that the password you will type at the login prompt matches the hash
# in a sops file (user-password). With users.mutableUsers = false and no root
# password, a mistyped hash means no login and no sudo after the install.
# Usage: check-login-password [SOPS_FILE]   (default secrets/p15v.yaml)
set -euo pipefail
cd "$(dirname "$0")/.."
file="${1:-secrets/p15v.yaml}"

hash=$(nix shell --inputs-from . nixpkgs#sops -c sops decrypt --extract '["user-password"]' "$file")
read -rsp "Login password: " pw
echo
# libxcrypt's crypt() re-hashes with the salt and parameters taken from $hash
if [[ "$(perl -e 'print crypt($ARGV[0], $ARGV[1])' "$pw" "$hash")" == "$hash" ]]; then
  echo "login password: OK"
else
  echo "login password: DOES NOT MATCH $file" >&2
  exit 1
fi
