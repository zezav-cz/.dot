#!/usr/bin/env bash
# One-time creation of the p15v secrets. Needs the YubiKey (PIN + touch).
#
#   1. age identity on the YubiKey (personal recipient) + an offline backup key
#   2. the p15v SSH host key (its age form is the host's sops recipient)
#   3. secrets/p15v.yaml: login password hash + Wi-Fi env, encrypted for
#      personal + backup + host
#   4. secrets/p15v-ssh-host-key.enc: the private host key, encrypted for
#      personal + backup only (decrypted on the installer ISO, see
#      doc/nixos-migration.md)
#
# Writes only public keys and encrypted files into the repo; private material
# lives in a temp dir that is shredded on exit. Recipients are passed with
# --age (and --config /dev/null) because .sops.yaml gets the p15v rules only
# once they are known; see secrets/p15v.recipients.
set -euo pipefail
cd "$(dirname "$0")/.."

run() {
  nix shell --inputs-from . nixpkgs#age nixpkgs#age-plugin-yubikey nixpkgs#sops \
    nixpkgs#ssh-to-age nixpkgs#mkpasswd -c "$@"
}

[[ -e secrets/p15v.yaml ]] && { echo "secrets/p15v.yaml already exists" >&2; exit 1; }

tmp=$(mktemp -d)
cleanup() { find "$tmp" -type f -exec shred -u {} + 2>/dev/null || true; rm -rf "$tmp"; }
trap cleanup EXIT

# 1. personal (YubiKey) and backup recipients
keys_dir="$HOME/.config/sops/age"
idfile="$keys_dir/yubikey-identity.txt"
mkdir -p "$keys_dir"
if [[ ! -s $idfile ]]; then
  echo ">> Creating an age identity on the YubiKey (enter PIN, touch the key)"
  run age-plugin-yubikey --generate --slot 1 --touch-policy cached --pin-policy once >"$idfile"
fi
personal=$(grep -o 'age1yubikey1[0-9a-z]*' "$idfile" | head -1)
identity=$(grep '^AGE-PLUGIN-YUBIKEY-' "$idfile")
grep -qF "$identity" "$keys_dir/keys.txt" 2>/dev/null || echo "$identity" >>"$keys_dir/keys.txt"

run age-keygen -o "$tmp/backup.agekey" 2>/dev/null
backup=$(run age-keygen -y "$tmp/backup.agekey")
echo
echo ">> Offline backup key. Save the whole block below in Bitwarden (secure note) now:"
echo
cat "$tmp/backup.agekey"
echo
read -rp "Saved? Type 'saved' to continue: " ok
[[ $ok == saved ]] || exit 1

# 2. host key
ssh-keygen -q -t ed25519 -N "" -C root@p15v -f "$tmp/ssh_host_ed25519_key"
cp "$tmp/ssh_host_ed25519_key.pub" secrets/p15v-ssh-host-key.pub
host=$(run ssh-to-age <"$tmp/ssh_host_ed25519_key.pub")

# 3. p15v.yaml
echo ">> Login password for jantrojak on p15v"
hash=$(run mkpasswd -m yescrypt)
read -rp "Home Wi-Fi SSID: " ssid
read -rsp "Home Wi-Fi password: " psk
echo
{
  printf 'user-password: %s\n' "$hash"
  printf 'wifi-env: |\n    HOME_SSID=%s\n    HOME_PSK=%s\n' "$ssid" "$psk"
} >"$tmp/p15v.yaml"
run sops --config /dev/null encrypt --age "$personal,$backup,$host" --input-type yaml --output-type yaml \
  "$tmp/p15v.yaml" >secrets/p15v.yaml

# 4. host private key, for the installer only
run sops --config /dev/null encrypt --age "$personal,$backup" --input-type binary --output-type binary \
  "$tmp/ssh_host_ed25519_key" >secrets/p15v-ssh-host-key.enc

printf 'personal %s\nbackup %s\np15v %s\n' "$personal" "$backup" "$host" >secrets/p15v.recipients

echo ">> Checking decryption with the YubiKey (touch it)"
run sops decrypt secrets/p15v.yaml | grep -c '^user-password:'
echo ">> Done. Public recipients are in secrets/p15v.recipients."
