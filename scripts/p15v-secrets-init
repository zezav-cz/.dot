#!/usr/bin/env bash
# One-time creation of the p15v secrets. Needs the YubiKey (OpenPGP PIN + touch).
#
#   1. recipients: the OpenPGP key on the YubiKey (personal; PIV stays off, see
#      doc/yubikey.md) + a new offline age backup key
#   2. the p15v SSH host key (its age form is the host's sops recipient)
#   3. secrets/p15v.yaml: login password hash + Wi-Fi env, encrypted for
#      personal + backup + host
#   4. secrets/p15v-ssh-host-key.enc: the private host key, encrypted for
#      personal + backup only (decrypted on the installer ISO, see
#      doc/nixos-migration.md)
#
# Writes only public keys and encrypted files into the repo; private material
# lives in a temp dir that is shredded on exit. Recipients are passed on the
# command line (with --config /dev/null) because .sops.yaml gets the p15v rules
# only once they are known; see secrets/p15v.recipients.
#
# PGP_FPR=<fingerprint> picks the OpenPGP key when there is more than one.
set -euo pipefail
cd "$(dirname "$0")/.."

# sops calls the system gpg (it needs ~/.gnupg with the card stubs)
run() {
  nix shell --inputs-from . nixpkgs#age nixpkgs#sops nixpkgs#ssh-to-age nixpkgs#mkpasswd -c "$@"
}

[[ -e secrets/p15v.yaml ]] && {
  echo "secrets/p15v.yaml already exists" >&2
  exit 1
}

tmp=$(mktemp -d)
cleanup() {
  find "$tmp" -type f -exec shred -u {} + 2>/dev/null || true
  rm -rf "$tmp"
}
trap cleanup EXIT

# 1. personal (OpenPGP on the YubiKey) and backup recipients
gpg --card-status >/dev/null
pgp="${PGP_FPR:-$(gpg --with-colons -K | awk -F: '/^sec/ {s = 1; next} s && /^fpr/ {print $10; exit}')}"
[[ -n $pgp ]] || {
  echo "no OpenPGP secret key found; set PGP_FPR" >&2
  exit 1
}
gpg -k "$pgp" | sed -n '1,3p'
read -rp "Use this OpenPGP key as the personal recipient? [y/N] " ok
[[ $ok == y ]] || exit 1
gpg --armor --export "$pgp" >keys/jantrojak-pgp.asc

run age-keygen -o "$tmp/backup.agekey" 2>/dev/null
backup=$(run age-keygen -y "$tmp/backup.agekey")
echo
echo ">> Offline backup key. Save the whole block below in Bitwarden (secure note) now:"
echo
cat "$tmp/backup.agekey"
echo
read -rp "Saved? Type 'saved' to continue: " ok
[[ $ok == saved ]] || exit 1

# 2. host key
ssh-keygen -q -t ed25519 -N "" -C root@p15v -f "$tmp/ssh_host_ed25519_key"
cp "$tmp/ssh_host_ed25519_key.pub" secrets/p15v-ssh-host-key.pub
host=$(run ssh-to-age <"$tmp/ssh_host_ed25519_key.pub")

# 3. p15v.yaml
# Asked twice: with users.mutableUsers = false a typo here locks you out.
read -rsp "Login password for jantrojak on p15v: " pw1
echo
read -rsp "Repeat it: " pw2
echo
[[ $pw1 == "$pw2" ]] || {
  echo "passwords differ" >&2
  exit 1
}
hash=$(printf '%s' "$pw1" | run mkpasswd -m yescrypt --stdin)
unset pw1 pw2
read -rp "Home Wi-Fi SSID: " ssid
read -rsp "Home Wi-Fi password: " psk
echo
{
  printf 'user-password: %s\n' "$hash"
  printf 'wifi-env: |\n    HOME_SSID=%s\n    HOME_PSK=%s\n' "$ssid" "$psk"
} >"$tmp/p15v.yaml"
run sops --config /dev/null encrypt --pgp "$pgp" --age "$backup,$host" \
  --input-type yaml --output-type yaml "$tmp/p15v.yaml" >secrets/p15v.yaml

# 4. host private key, for the installer only
run sops --config /dev/null encrypt --pgp "$pgp" --age "$backup" \
  --input-type binary --output-type binary "$tmp/ssh_host_ed25519_key" >secrets/p15v-ssh-host-key.enc

printf 'pgp %s\nbackup %s\np15v %s\n' "$pgp" "$backup" "$host" >secrets/p15v.recipients

echo ">> Checking decryption with the YubiKey (PIN / touch)"
run sops decrypt secrets/p15v.yaml | grep -c '^user-password:'
echo ">> Done. Public recipients are in secrets/p15v.recipients."
